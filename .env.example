# 在根目录新建 .env 使用这些配置；不覆盖已有 .env。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
PLAYBACK_MODE=proxy
# CORE-01 仅支持 mock。oss 是后续保留枚举，当前设置后会明确报错。
STORAGE_DRIVER=mock
USAGE_TIMEZONE=UTC
# 缺失表示未配置，不允许媒体注册。0 表示禁止传输；unlimited 为显式不限额。
# TRANSFER_LIMIT_BYTES=0
# MAX_PLAYBACK_SESSIONS=1
# CORE-02/03 正式库与安全密钥默认位于项目 .local，启动不会自动创建/迁移。
# DATABASE_PATH=E:/onlineVideo/.local/data/video-library.db
# AUTH_KEY_FILE=E:/onlineVideo/.local/secrets/auth.key
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000
AUTH_SESSION_TTL_MS=86400000
AUTH_FAILURE_WINDOW_MS=900000
AUTH_MAX_FAILURES=5
# 仅在明确可信反向代理时填写 IP/CIDR，默认不相信转发头。
# TRUSTED_PROXIES=127.0.0.1
