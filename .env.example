# 在根目录新建 .env 使用这些配置；不覆盖已有 .env。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# 默认简化业务：分类与标签来自 config/library.json，播放公共地址；legacy 保留旧私有链。
LIBRARY_MODE=public
PLAYBACK_MODE=oss
STORAGE_DRIVER=oss
USAGE_TIMEZONE=Asia/Shanghai
# 用户确认2GB按2GiB=2147483648字节；下列播放限额只用于 legacy。
MAX_UPLOAD_BYTES=2147483648
UPLOAD_PART_SIZE_BYTES=8388608
MAX_UPLOAD_CONCURRENCY=2
MAX_PLAYBACK_SESSIONS=3
MAX_AUTHORIZATIONS_PER_MINUTE=12
MEDIA_REQUESTS_PER_MINUTE=120
PLAYBACK_SESSION_TTL_MS=120000
IMPORT_PREVIEW_TTL_MS=600000
MAX_IMPORT_PREVIEWS=16
# 显式proxy模式另需配置该字节政策；oss直连字节未知，不套用每日硬封顶。
# TRANSFER_LIMIT_BYTES=0
OSS_BUCKET=xzlbucket
OSS_REGION=cn-hangzhou
OSS_OBJECT_PREFIX=onlineVideo/
# 仅 legacy 使用固定上传子范围；public 自动使用 onlineVideo/{categoryId}/{UUID}.{扩展名}。
# OSS_UPLOAD_OBJECT_PREFIX=onlineVideo/acceptance/local/<run-id>/
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_NETWORK=public
OSS_ALLOW_PUBLIC_NETWORK=true
OSS_PLAYBACK_ENDPOINT=https://oss.meetdawn.top
OSS_CREDENTIAL_FILE=E:/onlineVideo/.local/secrets/oss.json
OSS_ROLE_ARN_FILE=E:/onlineVideo/.local/secrets/ARN.txt
# public 不读取角色文件或调用 STS；下列角色/签名配置仅供 legacy，实际秘密放受保护文件。
OSS_STS_DURATION_SECONDS=3600
OSS_STS_REFRESH_BEFORE_SECONDS=300
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_CLOCK_SKEW_SECONDS=30
# FFprobe仅采集可选信息，缺失或失败不阻塞上传登记与浏览器直接尝试播放。
# FFPROBE_PATH=C:/path/to/ffprobe.exe
FFPROBE_TIMEOUT_MS=15000
FFPROBE_MAX_READ_BYTES=16777216
FFPROBE_MAX_CONCURRENT=1
# 正式库与安全密钥默认位于项目 .local；版本2正式迁移须授权，启动不会自动升级。
# DATABASE_PATH=E:/onlineVideo/.local/data/video-library.db
# AUTH_KEY_FILE=E:/onlineVideo/.local/secrets/auth.key
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000
AUTH_SESSION_TTL_MS=86400000
AUTH_FAILURE_WINDOW_MS=900000
AUTH_MAX_FAILURES=5
# 仅在明确可信反向代理时填写 IP/CIDR，默认不相信转发头。
# TRUSTED_PROXIES=127.0.0.1
