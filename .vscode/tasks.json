{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建共享类型",
      "type": "npm",
      "script": "build",
      "path": "packages/shared",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "启动真实前端",
      "type": "npm",
      "script": "dev:web",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "启动 API",
      "type": "npm",
      "script": "dev:api",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "完整工程检查",
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
