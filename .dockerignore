# Only these inputs are needed by the explicit COPY instructions.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/api/scripts/
!apps/api/scripts/copy-migrations.mjs
!apps/web/
!apps/web/**
!packages/
!packages/shared/
!packages/shared/**
!deploy/
!deploy/nginx.conf
!deploy/init-db.mjs
!deploy/deployment.json.example
!docs/
!docs/sql/
!docs/sql/NEW_INSTALL_FULL.sql

# Keep local dependencies, secrets and generated output out of every image.
**/node_modules
**/dist
**/.local
**/.npm-cache
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.auth.key
**/*.installation-code.txt
**/*.log
apps/web/qa
apps/web/HANDOFF.md
apps/web/README.md
packages/shared/tsconfig.tsbuildinfo
apps/web/test/stage2-real-oss.test.ts
apps/web/test/output
apps/web/test/reports
apps/web/test/artifacts
apps/web/test/screenshots
**/coverage
**/.nyc_output
**/blob-report
**/playwright-report
**/test-results
