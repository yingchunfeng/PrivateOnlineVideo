{
  "name": "@online-video/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:release": "tsc -p tsconfig.json --noEmit && node --import tsx test/release-build.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --import tsx --test test/unit.test.ts test/media-policy.test.ts test/video-upgrade.test.ts test/account-security.test.ts test/onboarding.test.ts test/theme.test.ts test/space-meteor-engine.test.ts test/space-enhancements.test.ts test/media-duration.test.ts test/guest-permissions.test.ts test/release-policy.test.ts",
    "test:theme": "node --import tsx --test test/theme.test.ts test/theme-browser.test.ts",
    "test:ui": "node --import tsx --test --test-concurrency=1 test/management-primitives-browser.test.ts test/ui-home-browser.test.ts test/ui-management-browser.test.ts",
    "test:ui:batch2": "node --import tsx --test --test-concurrency=1 test/site-settings-browser.test.ts test/video-data-browser.test.ts",
    "test:ui:batch3": "node --import tsx --test --test-concurrency=1 test/guest-browser.test.ts",
    "test:space": "node --import tsx --test --test-concurrency=1 test/space-console-browser.test.ts test/space-meteor-browser.test.ts test/space-enhancements-browser.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 test/video-upgrade-browser.test.ts test/simple-oss-browser.test.ts test/library-workflow-browser.test.ts test/account-security-browser.test.ts",
    "test:e2e:account": "node --import tsx --test --test-concurrency=1 test/account-security-browser.test.ts",
    "test:e2e:setup": "node --import tsx --test --test-concurrency=1 test/onboarding-browser.test.ts test/onboarding-http-browser.test.ts",
    "test:e2e:legacy": "node --import tsx --test test/browser.test.ts",
    "test:upgrade": "node --import tsx --test test/video-upgrade-browser.test.ts test/library-workflow-browser.test.ts",
    "test:stage2": "node --import tsx --test test/stage2-browser.test.ts",
    "test:stage2:long": "node --test --import tsx test/stage2-long-playback.test.ts",
    "test:production": "npm run build && node --import tsx --test test/production.test.ts"
  },
  "dependencies": {
    "@online-video/shared": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
